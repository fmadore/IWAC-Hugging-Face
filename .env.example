# Environment configuration for the IWAC Hugging Face pipeline
# Copy this file to .env and fill in your actual values. .env is gitignored.

# =============================================================================
# OMEKA S API CONFIGURATION (used by every upload script)
# =============================================================================
# Base URL of the Omeka S API. Optional: when unset, the uploads use the
# production collection at https://islam.zmo.de/api. Set it to run the
# pipeline against a different Omeka S archive.
#OMEKA_BASE_URL=https://your-omeka-instance.com/api

# API key identity and credential (Omeka S admin panel: User > API keys).
# REQUIRED by every upload, --dry-run included: an anonymous listing omits
# private items and properties, so an upload refuses to start without both.
# Use an account with access to the complete source.
OMEKA_KEY_IDENTITY=your_key_identity_here
OMEKA_KEY_CREDENTIAL=your_key_credential_here

# Public Omeka site used to build the iwac_url and iiif_manifest columns.
# Optional: defaults to OMEKA_BASE_URL without its /api suffix, else
# https://islam.zmo.de.
#IWAC_PUBLIC_BASE_URL=https://your-omeka-instance.com

# =============================================================================
# HUGGING FACE (needed by every upload and post-processing script)
# =============================================================================
# Token with WRITE access to the target dataset repos. Optional if you have
# logged in with `hf auth login`: the cached login is used when HF_TOKEN is
# unset, and a write-capable command without either starts an interactive
# login. Create one at: https://huggingface.co/settings/tokens
HF_TOKEN=your_hugging_face_token_here

# =============================================================================
# OPTIONAL — REPO REDIRECTION (see iwac_common/repos.py)
# =============================================================================
# Override the target dataset IDs to test against a scratch repo instead of
# the production ones. Strongly recommended before running any script that
# writes to the Hub for the first time. Defaults, if unset:
#   IWAC_HF_PRIVATE_REPO=fmadore/islam-west-africa-collection-full
#   IWAC_HF_PUBLIC_REPO=fmadore/islam-west-africa-collection
#IWAC_HF_PRIVATE_REPO=your-user/scratch-dataset-full
#IWAC_HF_PUBLIC_REPO=your-user/scratch-dataset

# Optional explicit dotenv file; process environment takes precedence.
#IWAC_ENV_FILE=/path/to/project.env
# Writable location for mirrors, caches, locks, model bundles and reports.
# For an installed wheel this defaults to the current working directory.
#IWAC_WORK_DIR=/path/to/iwac-work
# Hub write locks (default <work dir>/.iwac_locks) and upload recovery state,
# i.e. the stale-derived worklists (default <work dir>/.iwac_state). Keep the
# state directory across hosts if you use --preserve-derived.
#IWAC_LOCK_DIR=/path/to/iwac-work/.iwac_locks
#IWAC_STATE_DIR=/path/to/iwac-work/.iwac_state

# =============================================================================
# OPTIONAL — CONSOLE ENCODING
# =============================================================================
# Console output uses rich. On Windows, piping a script's output to a file or
# another process makes Python fall back to the cp1252 code page, which raises
# UnicodeEncodeError on the status icons and on Arabic or accented text. Set
# this for non-interactive runs.
#PYTHONUTF8=1

# =============================================================================
# SETUP
# =============================================================================
# 1. Copy this file to .env in the repository root
# 2. Fill in your credentials
# 3. Never commit .env — it is already listed in .gitignore
