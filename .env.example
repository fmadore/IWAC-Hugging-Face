# Environment configuration for the IWAC Hugging Face pipeline
# Copy this file to .env and fill in your actual values. .env is gitignored.

# =============================================================================
# OMEKA S API CONFIGURATION (required by every upload script)
# =============================================================================
# Base URL of the Omeka S API. The production collection lives at
# https://islam.zmo.de/api — point this at your own instance to run the
# pipeline against a different Omeka S archive.
OMEKA_BASE_URL=https://your-omeka-instance.com/api

# API key identity (Omeka S admin panel: User > API keys)
OMEKA_KEY_IDENTITY=your_key_identity_here

# API key credential (shown only once, at key creation)
OMEKA_KEY_CREDENTIAL=your_key_credential_here

# =============================================================================
# HUGGING FACE (required by every upload and post-processing script)
# =============================================================================
# Token with WRITE access to the target dataset repos.
# Create one at: https://huggingface.co/settings/tokens
HF_TOKEN=your_hugging_face_token_here

# =============================================================================
# GOOGLE GEMINI (required by the embedding scripts only)
# =============================================================================
# Used by post-processing/semantic_embedding.py and
# semantic_embedding_images.py. Get a key from Google AI Studio:
# https://aistudio.google.com/app/apikey
#
# GEMINI_API_KEY is accepted as a fallback if GOOGLE_API_KEY is unset, so an
# existing key from iwac-ai-pipelines (which names it GEMINI_API_KEY) works
# here without renaming.
GOOGLE_API_KEY=your_google_api_key_here

# =============================================================================
# OPTIONAL — REPO REDIRECTION (see iwac_common/repos.py)
# =============================================================================
# Override the target dataset IDs to test against a scratch repo instead of
# the production ones. Strongly recommended before running any script that
# writes to the Hub for the first time. Defaults, if unset:
#   IWAC_HF_PRIVATE_REPO=fmadore/islam-west-africa-collection-full
#   IWAC_HF_PUBLIC_REPO=fmadore/islam-west-africa-collection
#IWAC_HF_PRIVATE_REPO=your-user/scratch-dataset-full
#IWAC_HF_PUBLIC_REPO=your-user/scratch-dataset

# =============================================================================
# OPTIONAL — CONSOLE ENCODING
# =============================================================================
# Console output uses rich. On Windows, piping a script's output to a file or
# another process makes Python fall back to the cp1252 code page, which raises
# UnicodeEncodeError on the status icons and on Arabic or accented text. Set
# this for non-interactive runs.
#PYTHONUTF8=1

# =============================================================================
# SETUP
# =============================================================================
# 1. Copy this file to .env in the repository root
# 2. Fill in your credentials
# 3. Never commit .env — it is already listed in .gitignore
